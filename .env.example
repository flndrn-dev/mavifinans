# Neon: populated by neon deploy --env .env.local / neon env pull
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_FUNCTION_WEBSITE_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Generate a random server-only secret and declare it in the Function environment.
MAVI_ORIGIN_SECRET=

# Optional email notifications after the submission is stored successfully
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_AUDIENCE_ID=
CONTACT_FROM_EMAIL=mavi finans <noreply@mavifinans.eu>
CONTACT_TO_EMAIL=hello@mavifinans.eu

# Analytics (Umami)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=hello@mavifinans.eu
